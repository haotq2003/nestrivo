# ============================================
# Nestrivo Backend - Environment Variables
# Copy file này thành `.env` và điền giá trị thật
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/nestrivo?schema=public"

# Authentication (JWT)
JWT_SECRET="replace_with_a_strong_random_secret_key"
JWT_EXPIRES_IN="7d"

# Redis Cache (Local Docker hoặc Upstash Redis URL)
# Mặc định kết nối redis://127.0.0.1:6379, tự động fallback về DB nếu Redis tắt
REDIS_URL="redis://127.0.0.1:6379"

# MoMo Payment Gateway (Sandbox / Production - tùy chọn cho tính năng đẩy tin)
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"
MOMO_REDIRECT_URL="http://localhost:3000/landlord/dashboard"
MOMO_IPN_URL="http://localhost:5000/api/promotions/momo-ipn"
